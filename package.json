{
  "name": "dsh-local-font-picker",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "description": "Community DSH plugin for selecting installed local UI and code fonts in the DeepSeek Harness Web UI.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "fonts",
    "local-font-access"
  ],
  "engines": {
    "dsh": "0.1.6-alpha.2 || 0.1.7-alpha.2 || 0.1.7-rc.1 || 0.1.7-rc.2 || 0.2.0-rc.1 || 0.2.0-rc.2 || 0.2.1-alpha.1"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-store"
      ]
    }
  }
}